<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Galeria Zdjęć" Height="450" Width="800"
        Background="LightSlateGray">
    <Grid>
        <Image x:Name="img1" HorizontalAlignment="Center" Height="340" Margin="0,10,0,0" VerticalAlignment="Top" Width="514" Source="images/one.png" Stretch="UniformToFill"/>
        <Image x:Name="img2" HorizontalAlignment="Center" Height="340" Margin="0,10,0,0" VerticalAlignment="Top" Width="514" Source="images/two.png" Stretch="UniformToFill" Visibility="Hidden"/>
        <Image x:Name="img3" HorizontalAlignment="Center" Height="340" Margin="0,10,0,0" VerticalAlignment="Top" Width="514" Source="images/three.png" Stretch="UniformToFill" Visibility="Hidden"/>
        <Button Content="Polub" HorizontalAlignment="Center" Margin="0,371,0,0" VerticalAlignment="Top" Height="41" Width="254" Background="IndianRed" FontFamily="Arial" FontSize="24px" FontWeight="Bold" Click="likeClick"/>
        <Button Content="&lt;" HorizontalAlignment="Left" Margin="25,138,0,0" VerticalAlignment="Top" Height="79" Width="77" Background="DimGray" Foreground="White" FontFamily="Arial" FontSize="48px" FontWeight="Bold" Click="leftNextClick"/>
        <Button Content="&gt;" HorizontalAlignment="Left" Margin="693,138,0,0" VerticalAlignment="Top" Height="79" Width="77" Background="DimGray" Foreground="White" FontFamily="Arial" FontSize="48px" FontWeight="Bold" Click="rightNextClick"/>
        <TextBox x:Name="likesStrip" HorizontalAlignment="Center" Margin="0,318,0,0" TextWrapping="Wrap" Text="Likes: 0" VerticalAlignment="Top" Width="514" Height="32" Opacity="0.5" Background="Black" Foreground="White" FontSize="20px" TextAlignment="Center" TextChanged="likesCounter"/>

    </Grid>
</Window>
